# Connection string do Postgres. Pode ser um banco Neon (https://neon.tech, free tier)
# ou o Postgres local subido via docker-compose.yml na raiz do repo.
DATABASE_URL="postgresql://usuario:senha@host:5432/educacao_alagoas?sslmode=require"

# Porta em que a API Express escuta
PORT=3333

# Origem permitida pelo CORS (URL do frontend em desenvolvimento)
CORS_ORIGIN="http://localhost:5173"
